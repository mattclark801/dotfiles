# ==========================================
# ZSH OPTIONS & HISTORY
# ==========================================
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000

setopt EXTENDED_HISTORY          # Record timestamp and duration
setopt SHARE_HISTORY             # Share history across running sessions
setopt HIST_EXPIRE_DUPS_FIRST    # Expire duplicate entries first
setopt HIST_IGNORE_DUPS          # Don't record consecutive duplicates
setopt HIST_IGNORE_ALL_DUPS      # Delete older duplicates when new added
setopt HIST_FIND_NO_DUPS         # Do not display duplicates when searching
setopt HIST_REDUCE_BLANKS        # Remove superfluous blanks from history
setopt AUTO_CD                   # Type directory name to cd into it

# ==========================================
# VI KEYBINDINGS & CURSOR SHAPE
# ==========================================
bindkey -v
export KEYTIMEOUT=15  # 150ms timeout for 'jk' sequence

# Change cursor shape: Steady Beam (line) in Insert mode, Steady Block in Normal mode
function zle-keymap-select {
  if [[ ${KEYMAP} == vicmd ]] || [[ $1 = 'block' ]]; then
    echo -ne '\e[2 q'  # Block cursor
  elif [[ ${KEYMAP} == main ]] || [[ ${KEYMAP} == viins ]] || [[ ${KEYMAP} = '' ]] || [[ $1 = 'beam' ]]; then
    echo -ne '\e[6 q'  # Beam cursor
  fi
}
zle -N zle-keymap-select

# Reset cursor back to beam before printing each new prompt line
_fix_cursor() {
  echo -ne '\e[6 q'
}
precmd_functions+=(_fix_cursor)

# Quick exit from Insert mode to Normal mode with 'jk'
bindkey -M viins 'jk' vi-cmd-mode

# Retain common convenience shortcuts while in Insert mode
bindkey -M viins '^A' beginning-of-line
bindkey -M viins '^E' end-of-line
bindkey -M viins '^W' backward-kill-word
bindkey -M viins '^U' backward-kill-line

# ==========================================
# HISTORY SEARCH BINDINGS (Prefix search in both modes)
# ==========================================
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search

# Insert mode arrow keys
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search

# Normal mode 'k' and 'j'
bindkey -M vicmd 'k' up-line-or-beginning-search
bindkey -M vicmd 'j' down-line-or-beginning-search

# ==========================================
# COMPLETION SYSTEM & FZF-TAB
# ==========================================
autoload -Uz compinit
if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qN.m+1) ]]; then
  compinit
else
  compinit -C
fi

# Case-insensitive tab completion & colors
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' menu select
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# Enable fzf-tab (MUST load after compinit, before syntax-highlighting)
if [ -f ~/.local/share/zsh/plugins/fzf-tab/fzf-tab.plugin.zsh ]; then
  source ~/.local/share/zsh/plugins/fzf-tab/fzf-tab.plugin.zsh
  # Disable default sort when completing git checkout/switch
  zstyle ':completion:*:git-checkout:*' sort false
  # Force fzf-tab to use tmux popup if inside tmux
  zstyle ':fzf-tab:*' fzf-command ftb-tmux-popup
fi

# ==========================================
# TOOL INTEGRATIONS & PATHS
# ==========================================
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

# fnm (Fast Node Manager)
if command -v fnm &>/dev/null; then
  eval "$(fnm env --use-on-cd --shell zsh)"
fi

# uv (Fast Python Package Installer)
if command -v uv &>/dev/null; then
  eval "$(uv generate-shell-completion zsh 2>/dev/null)"
fi

# zoxide (Smarter cd)
if command -v zoxide &>/dev/null; then
  eval "$(zoxide init zsh)"
fi

# fzf keybindings and completion
if [ -f /usr/share/doc/fzf/examples/key-bindings.zsh ]; then
  source /usr/share/doc/fzf/examples/key-bindings.zsh
  source /usr/share/doc/fzf/examples/completion.zsh
elif [ -f ~/.fzf.zsh ]; then
  source ~/.fzf.zsh
fi

# ==========================================
# OS-SPECIFIC SETTINGS
# ==========================================
{{ if and (eq .chezmoi.os "linux") (contains "microsoft" (lower .chezmoi.kernel.osrelease)) }}
# WSL2 on Windows 11 specific paths and aliases
alias open="explorer.exe"
{{ else if eq .chezmoi.os "linux" }}
# Native Linux Mint specific aliases
alias open="xdg-open"
{{ end }}

# Common Aliases
alias ll='ls -la --color=auto'
alias gs='git status'
alias cm='chezmoi'

# ==========================================
# GIT ALIASES (Curated from Oh My Zsh)
# ==========================================
alias g='git'

# Status & Inspection
alias gst='git status'
alias gd='git diff'
alias gds='git diff --staged'
alias glog='git log --graph --pretty=format:"%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset" --abbrev-commit'

# Staging & Commits
alias ga='git add'
alias gaa='git add --all'
alias gc='git commit -v'
alias gcm='git commit -m'
alias gca!='git commit -v -a --amend'

# Branching & Switching
alias gco='git checkout'
alias gcb='git checkout -b'
alias gsw='git switch'
alias gswc='git switch -c'

# Pull & Push
alias gl='git pull'
alias gp='git push'
alias gpf!='git push --force-with-lease'

# Stashing
alias gsta='git stash push'
alias gstp='git stash pop'

# ==========================================
# PLUGINS (Source before prompt)
# ==========================================
[ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ] && source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
[ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ] && source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# Custom autosuggestion styling (subtle muted gray)
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=244'

# ==========================================
# STARSHIP PROMPT (Must be initialized last)
# ==========================================
if command -v starship &>/dev/null; then
  eval "$(starship init zsh)"
fi
