{{ if eq .chezmoi.os "linux" -}}
#!/bin/sh
if ! command -v zsh >/dev/null 2>&1 || [ ! -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]; then
    echo "==> Auto-installing Zsh and core plugins..."
    sudo apt-get update && sudo apt-get install -y zsh zsh-autosuggestions zsh-syntax-highlighting
fi

if [ "$SHELL" != "$(which zsh)" ]; then
    echo "==> Setting default login shell to zsh..."
    sudo chsh -s "$(which zsh)" "$USER"
fi
{{ end -}}
