#!/bin/bash
set -euo pipefail

# --- 1. System Packages ---
{{ if eq .chezmoi.os "linux" }}
PACKAGES=(
  zsh
  fzf
  zsh-autosuggestions
  zsh-syntax-highlighting
)

# Install xclip only on native Linux Mint (exclude WSL)
{{ if not (contains "microsoft" (lower .chezmoi.kernel.osrelease)) }}
PACKAGES+=(xclip)
{{ end }}

# Install missing packages
MISSING=()
for pkg in "${PACKAGES[@]}"; do
  if ! dpkg -s "$pkg" &>/dev/null; then
    MISSING+=("$pkg")
  fi
done

if [ ${#MISSING[@]} -gt 0 ]; then
  echo "Installing missing packages: ${MISSING[*]}"
  sudo apt-get update
  sudo apt-get install -y "${MISSING[@]}"
fi
{{ end }}

# --- 2. Zsh Plugins ---
FZF_TAB_DIR="$HOME/.local/share/zsh/plugins/fzf-tab"
if [ ! -d "$FZF_TAB_DIR" ]; then
  echo "Cloning fzf-tab plugin..."
  mkdir -p "$HOME/.local/share/zsh/plugins"
  git clone https://github.com/Aloxaf/fzf-tab "$FZF_TAB_DIR"
fi
