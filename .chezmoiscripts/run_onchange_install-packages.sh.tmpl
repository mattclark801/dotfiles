#!/bin/bash
set -euo pipefail

echo "==> Installing system dependencies via apt..."
sudo apt update
sudo apt install -y \
    tmux \
    ripgrep \
    fd-find \
    fzf \
    bat \
    build-essential \
    unzip \
    jq \
    gpg \
    wget \
    curl

# Fix Debian/Ubuntu naming divergence for fd and bat
mkdir -p "$HOME/.local/bin"
ln -sf "$(which fdfind)" "$HOME/.local/bin/fd" 2>/dev/null || true
ln -sf "$(which batcat)" "$HOME/.local/bin/bat" 2>/dev/null || true

# Install Zoxide (frecency cd)
if ! command -v zoxide &> /dev/null; then
    echo "==> Installing zoxide..."
    curl -sSfL https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh | sh
fi

# Install Starship prompt
if ! command -v starship &> /dev/null; then
    echo "==> Installing starship..."
    curl -sS https://starship.rs/install.sh | sh -s -- -y
fi

# Install Eza (modern ls) via official community debian repo
if ! command -v eza &> /dev/null; then
    echo "==> Installing eza..."
    sudo mkdir -p /etc/apt/keyrings
    wget -qO- https://raw.githubusercontent.com/eza-community/eza/main/deb.asc | sudo gpg --dearmor -o /etc/apt/keyrings/gierens.gpg --yes
    echo "deb [signed-by=/etc/apt/keyrings/gierens.gpg] http://deb.gierens.de stable main" | sudo tee /etc/apt/sources.list.d/gierens.list
    sudo chmod 644 /etc/apt/keyrings/gierens.gpg /etc/apt/sources.list.d/gierens.list
    sudo apt update
    sudo apt install -y eza
fi

# Install Tmux Plugin Manager (TPM)
if [ ! -d "$HOME/.tmux/plugins/tpm" ]; then
    echo "==> Cloning Tmux Plugin Manager (TPM)..."
    git clone https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"
fi
