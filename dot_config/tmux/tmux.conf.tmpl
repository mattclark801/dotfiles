# Prefix: Ctrl-a
unbind C-b
set -g prefix C-a
bind C-a send-prefix

# Ergonomics
set -g mouse on
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on
set -g default-terminal "tmux-256color"
set -ga terminal-overrides ",*256col*:Tc"
set -s escape-time 0
set -g history-limit 50000

# Vi mode navigation & copy
setw -g mode-keys vi
bind -T copy-mode-vi v send -X begin-selection

{{- if (contains "WSL" .chezmoi.kernel.osrelease) }}
# WSL -> Windows system clipboard bridge
bind -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "clip.exe"
bind-key -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "clip.exe"
{{- else }}
# Standard Linux X11/Wayland clipboard fallback
bind -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "xclip -in -selection clipboard"
{{- end }}

# TPM Plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'

# Auto-restore sessions on Tmux start
set -g @continuum-restore 'on'

run '~/.tmux/plugins/tpm/tpm'

# ----------------------
# Solarized Dark Palette
# ----------------------
# default statusbar colors
set -g status-style bg='#073642',fg='#839496'

# default window title colors
setw -g window-status-style fg='#839496',bg=default

# active window title colors
setw -g window-status-current-style fg='#b58900',bold,bg=default

# pane border
set -g pane-border-style fg='#073642'
set -g pane-active-border-style fg='#586e75'

# message text
set -g message-style bg='#073642',fg='#cb4b16'

# pane number display
set -g display-panes-active-colour '#268bd2'
set -g display-panes-colour '#b58900'

# clock
setw -g clock-mode-colour '#859900'

# status bar formatting
set -g status-left-length 30
set -g status-left '#[fg=#859900,bold]#S #[fg=#586e75]│ '
set -g status-right '#[fg=#586e75]│ #[fg=#268bd2]%Y-%m-%d %H:%M '
